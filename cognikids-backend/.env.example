# ====================================
# CogniKids Backend - Variáveis de Ambiente
# ====================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SUAS CREDENCIAIS
# NÃO COMMITE O .env NO GIT!

# Chave secreta usada para assinar E validar os tokens JWT e as sessions
# Flask. Gere uma chave segura:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A API não inicia sem esta variável.
SECRET_KEY="sua-chave-secreta-aqui"

# Chave da API de IoT (autentica as pulseiras em POST /api/iot/data).
# Deve ser a mesma configurada no firmware da pulseira.
SECRET_API_KEY="sua-chave-api-iot-aqui"

# URI do MongoDB
# Para Docker: mongodb://db:27017/cognikidsDB
# Para local:  mongodb://localhost:27017/cognikidsDB
MONGO_URI="mongodb://db:27017/cognikidsDB"

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# Use a URL do dashboard Streamlit. Evite "*" em produção.
CORS_ORIGINS="http://localhost:8501"

# Ambiente do Flask
# FLASK_DEBUG=1 habilita o debugger interativo — APENAS em desenvolvimento.
FLASK_ENV="development"
FLASK_DEBUG=0

# --- Pipeline IoT (opcionais: valores padrão funcionam no Docker) ---
REDIS_HOST="redis"
REDIS_PORT=6379
MQTT_BROKER_HOST="mosquitto"
MQTT_PORT=1883
MQTT_TOPIC="cognikids/iot/data"

# Teto da fila Redis: descarta as leituras mais antigas se o consumidor
# não acompanhar, evitando esgotar a memória do Redis.
IOT_QUEUE="iot_queue"
IOT_QUEUE_MAX=50000

# Caminho do modelo treinado consumido pelo alert_monitor.py
# Gere com: python scripts/utils/train_model.py
MODEL_PATH="model.joblib"

# --- Uploads (galeria de criações) ---
UPLOAD_FOLDER="uploads"
MAX_UPLOAD_BYTES=5242880
