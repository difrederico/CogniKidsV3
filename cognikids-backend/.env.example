# ====================================
# CogniKids Backend - Variáveis de Ambiente
# ====================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SUAS CREDENCIAIS
# NÃO COMMITE O .env NO GIT!

# Chave secreta usada para assinar E validar os tokens JWT e as sessions
# Flask. Gere uma chave segura:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A API não inicia sem esta variável.
SECRET_KEY="sua-chave-secreta-aqui"

# Chave da API de IoT (autentica as pulseiras em POST /api/iot/data).
# Deve ser a mesma configurada no firmware da pulseira.
SECRET_API_KEY="sua-chave-api-iot-aqui"

# URI do MongoDB
# Para Docker: mongodb://db:27017/cognikidsDB
# Para local:  mongodb://localhost:27017/cognikidsDB
MONGO_URI="mongodb://db:27017/cognikidsDB"

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# Use a URL do dashboard Streamlit. Evite "*" em produção.
CORS_ORIGINS="http://localhost:8501"

# Ambiente do Flask
# FLASK_DEBUG=1 habilita o debugger interativo — APENAS em desenvolvimento.
FLASK_ENV="development"
FLASK_DEBUG=0

# --- Pipeline IoT (opcionais: valores padrão funcionam no Docker) ---
REDIS_HOST="redis"
REDIS_PORT=6379
MQTT_BROKER_HOST="mosquitto"
MQTT_PORT=1883
MQTT_TOPIC="cognikids/iot/data"

# Teto da fila Redis: descarta as leituras mais antigas se o consumidor
# não acompanhar, evitando esgotar a memória do Redis.
IOT_QUEUE="iot_queue"
IOT_QUEUE_MAX=50000

# Caminho do modelo treinado consumido pelo alert_monitor.py
# Gere com: python scripts/utils/train_model.py
MODEL_PATH="model.joblib"

# --- Limiares de severidade de alerta (ADR-010) ---
# Nao validados clinicamente ainda: train_model.py treina com dado
# sintetico, e LIMIAR_BPM_ALTO=130 marca severidade maxima — 130 bpm e uma
# crianca de 7 anos no recreio, nao necessariamente uma crise. Ajuste aqui
# assim que houver validacao real, sem precisar mexer em codigo.
LIMIAR_BPM_ALTO=130
LIMIAR_GSR_ALTO=4.0

# So mude para "true" depois de validar o modelo/limiares acima com dado
# real (ver ADR-010 em docs/architecture/ADRS.md). Enquanto for "false",
# todo alerta grava modelo_validado=false, visivel na tela do professor —
# e a garantia de que "nenhum uso com crianca real" nao depende de alguem
# lembrar de um comentario.
MODELO_RISCO_VALIDADO="false"

# --- Satélite (cascata de revogação de consentimento, ADR-008/ADR-010) ---
# Opcional: o core continua funcionando sem o satélite. Usada só quando
# coleta_biometrica é revogada, para pedir ao satélite que apague
# student_graphs/telemetry_events do aluno. Precisa apontar para o gateway
# do satélite (docker-compose.yml na raiz do monorepo, serviço "gateway").
SATELLITE_BASE_URL="http://localhost:8001"

# --- Uploads (galeria de criações) ---
UPLOAD_FOLDER="uploads"
MAX_UPLOAD_BYTES=5242880
