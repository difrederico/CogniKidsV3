# ============================================================
# CogniKids — variáveis do serviço satélite (cognikids-adapt/)
# O core (cognikids-backend/) usa seu próprio .env — ver
# cognikids-backend/.env.example
# ============================================================

# --- Core (apenas leitura, só via HTTP — nunca Mongo direto) ---
CORE_BASE_URL=http://localhost:5001
CORE_JWT_SECRET=<mesmo secret do Flask core>
# ObjectId de um usuário tipo='admin' real na base do core — usado por
# worker_profile.py para montar o JWT de serviço (pode_ver_aluno libera
# qualquer aluno para admin). Sem isso, GET /api/accessibility falha (o
# worker degrada e segue sem tokens, mas o cold start fica sempre vazio).
# Criar com (exige acesso ao servidor — POST /api/register é rota pública e
# recusa tipo='admin' desde a correção de segurança; ver Utils/roles.py):
#   cd cognikids-backend
#   python scripts/criar_admin.py --nome "Satelite CogniKids (service account)" \
#       --email satelite-service@cognikids.internal
# O script imprime o ObjectId. Cole abaixo.
CORE_SERVICE_USER_ID=<ObjectId de um usuário admin no core>

# --- Satélite (novo) ---
SATELLITE_MONGO_URI=mongodb://localhost:27018/cognikids_adapt
RABBITMQ_EXCHANGE=cognikids

# Credenciais do broker. Nunca use guest:guest — o console de administração
# do RabbitMQ ficava publicado em 0.0.0.0:15672 com essa senha padrão.
# Gere uma senha aleatória, ex.: python -c "import secrets;print(secrets.token_urlsafe(32))"
RABBITMQ_USER=cognikids
RABBITMQ_PASS=<senha aleatória — não deixe em branco>
RABBITMQ_URL=amqp://cognikids:<mesma senha acima>@localhost:5672/

# --- LLM (híbrido, custo zero — ver ADR-002 em CLAUDE.md) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
GEMINI_API_KEY=<sua chave Gemini — fallback gratuito, Google AI Studio>

# --- Gateway ---
GATEWAY_PORT=8001
GATEWAY_HOST=0.0.0.0
