datasets/raw/

# --- Variáveis de ambiente e segredos ---
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Ambientes virtuais ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# --- Testes / cobertura ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Streamlit ---
.streamlit/secrets.toml

# --- Node (caso futuro) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
*.log
docker-compose.override.yml

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini

# --- Banco de dados local / dumps ---
*.db
*.sqlite
*.sqlite3
dump/
backups/

# --- Logs ---
logs/
*.log

# --- Configurações específicas que NÃO devem ser versionadas ---
cognikids-pulseira-m5stack/config.py
cognikids-front-end/data/

# --- Uploads de usuarios (galeria de criacoes) ---
cognikids-backend/uploads/

# --- Modelo de ML treinado (gerar com scripts/utils/train_model.py) ---
*.joblib
model.joblib
